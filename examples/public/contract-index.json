        ],
        "blocked_claims": [
          "achieved slot duration measured",
          "faster confirmations or lower latency proven",
          "better landing or market quality proven",
          "Blocksize validator readiness or performance proven",
          "signing or transaction submission supported"
        ]
      }
    }
  ]
}
