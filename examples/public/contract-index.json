          "public package checksums and DQ gates passed",
          "read-only and dry-run only"
        ],
        "blocked_claims": [
          "trader state decoded",
          "instruction builders used",
          "wallet-authenticated routes used",
          "historical replay ready",
          "signing or transaction submission supported"
        ]
      }
    },
    {
      "package_id": "slot-regime-benchmark-v0",
      "package_type": "runtime_benchmark_boundary",
      "protocol": "solana_runtime",
      "capability": "read_only_dry_run",
      "manifest_path": "examples/public/slot-regime-benchmark-v0/manifest.json",
      "dq_path": "examples/public/slot-regime-benchmark-v0/dq.json",
      "payloads": [
        {
          "role": "benchmark_windows",
