{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jf-cmyk/open-perps-reliability-stack/schemas/datasets/public-contract-index-v0.json",
  "title": "Open Perps Reliability Stack Public Contract Index v0",
  "type": "object",
  "required": ["contract_index_version", "packages"],
  "properties": {
    "contract_index_version": { "const": "oprs.public_contract_index.v0" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["package_id", "package_type", "protocol", "capability", "manifest_path", "dq_path", "payloads", "validator", "publishable", "claim_boundary"],
        "properties": {
          "package_id": { "type": "string", "minLength": 1 },
          "package_type": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string", "minLength": 1 },
          "capability": { "const": "read_only_dry_run" },
          "manifest_path": { "$ref": "#/$defs/relative_path" },
          "dq_path": { "$ref": "#/$defs/relative_path" },
          "payloads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "path", "schema_path", "schema_version"],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "path": { "$ref": "#/$defs/relative_path" },
                "schema_path": { "$ref": "#/$defs/relative_path" },
                "schema_version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "validator": { "$ref": "#/$defs/relative_path" },
          "publishable": { "type": "boolean" },
          "claim_boundary": {
            "type": "object",
            "required": ["allowed_claims", "blocked_claims"],
            "properties": {
              "allowed_claims": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "blocked_claims": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "^https?://" }
        ]
      }
    }
  },
  "additionalProperties": false
}
