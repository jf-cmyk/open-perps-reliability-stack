{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jf-cmyk/open-perps-reliability-stack/schemas/datasets/slot-regime-benchmark-v0.json",
  "title": "Open Perps Reliability Stack Slot Regime Benchmark v0",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_name",
    "protocol",
    "chain_id",
    "generated_from",
    "activation",
    "records",
    "readiness",
    "known_gaps"
  ],
  "properties": {
    "schema_version": { "const": "oprs.slot_regime_benchmark.v0" },
    "dataset_name": { "type": "string", "minLength": 1 },
    "protocol": { "const": "solana_runtime" },
    "chain_id": { "const": "solana-mainnet-beta" },
    "generated_from": { "type": "string", "minLength": 1 },
    "activation": {
      "type": "object",
      "required": [
        "feature_account",
        "activation_slot",
        "activation_block_time",
        "previous_slot_duration_target_ms",
        "new_slot_duration_target_ms",
        "verification_method"
      ],
      "properties": {
        "feature_account": { "type": "string", "minLength": 1 },
        "activation_slot": { "type": "integer", "minimum": 1 },
        "activation_block_time": { "type": "string", "minLength": 1 },
        "previous_slot_duration_target_ms": { "const": 400 },
        "new_slot_duration_target_ms": { "const": 350 },
        "verification_method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "window_id",
          "relation_to_activation",
          "slot_range",
          "measurement_role",
          "read_only_supported",
          "benchmark_uses",
          "public_source_refs",
          "blocked_claims"
        ],
        "properties": {
          "window_id": { "type": "string", "minLength": 1 },
          "relation_to_activation": { "enum": ["pre_activation", "post_activation"] },
          "slot_range": {
            "type": "object",
            "required": ["start_slot", "end_slot", "slot_duration_target_ms"],
            "properties": {
              "start_slot": { "type": "integer", "minimum": 1 },
              "end_slot": { "type": "integer", "minimum": 1 },
              "slot_duration_target_ms": { "enum": [400, 350] }
            },
            "additionalProperties": false
          },
          "measurement_role": { "type": "string", "minLength": 1 },
          "read_only_supported": { "const": true },
          "benchmark_uses": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "public_source_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "blocked_claims": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "activation_boundary_verified",
        "slot_duration_observed",
        "performance_improvement_claimed",
        "validator_performance_claimed",
        "execution_claimed",
        "replay_ready"
      ],
      "properties": {
        "activation_boundary_verified": { "const": true },
        "slot_duration_observed": { "const": false },
        "performance_improvement_claimed": { "const": false },
        "validator_performance_claimed": { "const": false },
        "execution_claimed": { "const": false },
        "replay_ready": { "const": false }
      },
      "additionalProperties": false
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
