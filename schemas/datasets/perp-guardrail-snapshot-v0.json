{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jf-cmyk/open-perps-reliability-stack/schemas/datasets/perp-guardrail-snapshot-v0.json",
  "title": "Open Perps Reliability Stack Perp Guardrail Snapshot v0",
  "type": "object",
  "required": ["schema_version", "dataset_name", "protocol", "chain_id", "source_commit", "generated_from", "records", "readiness", "known_gaps"],
  "properties": {
    "schema_version": { "const": "oprs.perp_guardrail_snapshot.v0" },
    "dataset_name": { "type": "string", "minLength": 1 },
    "protocol": { "const": "drift_v2" },
    "chain_id": { "const": "solana-mainnet-beta" },
    "source_commit": { "type": "string", "minLength": 40, "maxLength": 40 },
    "generated_from": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record_id", "market", "market_index", "base_asset", "status", "contract_type", "contract_tier", "perp_pause_flags", "quality_flags"],
        "properties": {
          "record_id": { "type": "string", "minLength": 1 },
          "market": { "type": "string", "minLength": 1 },
          "market_index": { "type": "integer", "minimum": 0 },
          "base_asset": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/labeled_u8" },
          "contract_type": { "$ref": "#/$defs/labeled_u8" },
          "contract_tier": { "$ref": "#/$defs/labeled_u8" },
          "perp_pause_flags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "quality_flags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "readiness": { "$ref": "#/$defs/readiness" },
    "known_gaps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "labeled_u8": {
      "type": "object",
      "required": ["raw_value", "label", "semantic_source"],
      "properties": {
        "raw_value": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "semantic_source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["public_guardrails_decoded", "user_state_decoded", "market_economics_decoded", "replay_ready"],
      "properties": {
        "public_guardrails_decoded": { "const": true },
        "user_state_decoded": { "const": false },
        "market_economics_decoded": { "const": false },
        "replay_ready": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
